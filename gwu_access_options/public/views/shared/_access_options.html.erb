<%# 1. LOGIC BLOCK %>
<% 
  item_uri = result.uri.to_s
  is_grc = item_uri.include?('/repositories/3')
  repo_key = is_grc ? 'grc' : 'scrc'
  cfg = t("gwu_custom.repos.#{repo_key}", default: {})
  
  item_ref_id = result.json['ref_id'] || "N/A"

  container_info = ""
  if result.json['instances']
    instance = result.json['instances'].find {|inst| inst['sub_container'].present? }
    if instance
      top_con = instance.dig('sub_container', 'top_container', '_resolved')
      if top_con
        container_info = "#{top_con['type']&.capitalize} #{top_con['indicator']}"
        container_info += " [Barcode: #{top_con['barcode']}]" if top_con['barcode'].present?
      end
    end
  end

  has_online_content = result.json['representative_file_version'].present? || (dig.present? && dig.any? { |d| d['out'].present? })
  
  base_url = AppConfig[:public_proxy_url].to_s.chomp('/')
  full_url = "#{base_url}#{result.uri}"
%>

<%# 2. HTML CONTENT %>
<% gwu_body = capture do %>
  <div class="access-options-container">
    <div class="access-options-inner">
      
      <%# Status Alert Area %>
      <div class="alert access-alert <%= has_online_content ? 'alert-info' : 'access-alert-warning' %>">
        <% if has_online_content %> 
          <i class="fa fa-cloud-download"></i> <%= t('gwu_custom.status.online') %>
        <% elsif dig.present? %> 
          <i class="fa fa-comments-o"></i> <strong><%= t('gwu_custom.status.restricted') %></strong>
        <% else %> 
          <i class="fa fa-info-circle"></i> <strong><%= t('gwu_custom.status.default') %></strong>
        <% end %>
      </div>

      <%# Start of the Row for Columns %>
      <div class="row">
        
        <%# Column 1: Facilitate/Request %>
        <div class="col-md-4">
          <h3 class="access-title"><%= t('gwu_custom.facilitate_label') %></h3>
          <div class="access-well">
            <span id="visible-barcode-text">
              <% if container_info.present? %>
                <%= container_info %>
              <% else %>
                <%= item_ref_id %>
              <% end %>
            </span>
            
            <div id="request-payload" style="display:none;">
              Ref ID: <%= item_ref_id %>
              Title: <%= record_title %>
              Container: <%= container_info.presence || "Digital/No Physical Container" %>
              URL: <%= full_url %>
            </div>

            <button type="button" id="copy-btn" class="btn btn-xs btn-default pull-right" title="Copy full details" style="border:none; background:transparent;">
              <i class="fa fa-copy"></i>
            </button>
          </div>
          
          <div id="copy-success" style="display:none; color: #28a745; font-size: 0.8em; margin-bottom: 5px;">
            <i class="fa fa-check"></i> Copied full details!
          </div>
          
          <a href="<%= cfg[:contact_url] %>" class="btn btn-sm btn-primary access-btn-full">
            <%= t('gwu_custom.request_btn_text', repo: cfg[:name]) %>
          </a>
        </div>

        <%# Column 2: Visit %>
        <div class="col-md-4 access-col-divider">
          <h3 class="access-title"><%= t('gwu_custom.visit_label') %></h3>
          <p class="access-text-small"><%= t('gwu_custom.visit_text_preview') %></p>
          <a href="<%= cfg[:visit_url] %>" target="_blank" class="btn btn-sm btn-default access-btn-left">
            <i class="fa fa-external-link"></i> <%= t('gwu_custom.visit_link_text') %>
          </a>
          <a href="<%= t('gwu_custom.copyright_url') %>" target="_blank" class="btn btn-sm btn-default access-btn-left">
            <i class="fa fa-external-link"></i> <%= t('gwu_custom.copyright_link_text') %>
          </a>
        </div>

        <%# Column 3: Consult %>
        <div class="col-md-4 access-col-divider">
          <h3 class="access-title"><%= t('gwu_custom.consult_title') %></h3>
          <p class="access-text-small"><%= t('gwu_custom.consult_text') %></p>
          <a href="<%= cfg[:contact_url] %>" class="btn btn-sm btn-default access-btn-left">
            <i class="fa fa-envelope-o"></i> <%= t('gwu_custom.message_btn_text') %>
          </a>
        </div>

      </div> <%# End Row %>
    </div> <%# End Inner %>
  </div> <%# End Container %>
<% end %>

<%= render partial: 'shared/accordion_panel', locals: { :p_title => t('gwu_custom.panel_title'), :p_id => 'access_options_list', :p_body => gwu_body } %>