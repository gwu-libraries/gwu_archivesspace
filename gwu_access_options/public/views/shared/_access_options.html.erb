<%# 1. LOGIC BLOCK %>
<% 
  dig = local_assigns[:dig] || []
  item_uri = result.uri.to_s
  is_grc = item_uri.include?('/repositories/3')
  repo_key = is_grc ? 'grc' : 'scrc'
  cfg = t("gwu_custom.repos.#{repo_key}", default: {})
  
  item_ref_id = result.json['ref_id'] || "N/A"

  # 1. Container Details Parsing
  container_info = ""
  con_type = ""
  con_indicator = ""

  if result.json['instances']
    instance = result.json['instances'].find { |inst| inst['sub_container'].present? }
    if instance
      top_con = instance.dig('sub_container', 'top_container', '_resolved')
      if top_con
        con_type = top_con['type']&.capitalize || 'Container'
        con_indicator = top_con['indicator'].to_s
        container_info = "#{con_type} #{con_indicator}"
        container_info += " [Barcode: #{top_con['barcode']}]" if top_con['barcode'].present?
      end
    end
  end

  has_physical_container = container_info.present?

  # 2. Extract Hierarchy via ArchivesSpace Breadcrumb Helper
  hierarchy_nodes = []
  resource_title = ""
  resource_id = ""

  if result.respond_to?(:breadcrumb) && result.breadcrumb.present?
    # result.breadcrumb returns an array of hashes: [{:crumb => "Title", :uri => "...", :type => "..."}]
    hierarchy_nodes = result.breadcrumb.map do |crumb|
      # Strip HTML tags/markup from titles
      ActionView::Base.full_sanitizer.sanitize(crumb[:crumb]).to_s.strip
    end.compact.reject(&:empty?)

    resource_title = hierarchy_nodes.first || ""
  elsif result.respond_to?(:ancestors) && result.ancestors.present?
    # Fallback to ancestors array if breadcrumb helper isn't directly bound
    hierarchy_nodes = result.ancestors.map do |anc|
      title = anc['title'] || anc['_resolved']&.fetch('title', nil)
      ActionView::Base.full_sanitizer.sanitize(title).to_s.strip if title.present?
    end.compact.reject(&:empty?).reverse
    
    resource_title = hierarchy_nodes.first || ""
  end

  # Fallback to direct JSON traversal if hierarchy is still empty
  if hierarchy_nodes.empty? && result.json['ancestors'].present?
    result.json['ancestors'].each do |anc|
      title = anc['_resolved']&.fetch('title', nil) || anc['title']
      hierarchy_nodes << ActionView::Base.full_sanitizer.sanitize(title).to_s.strip if title.present?
    end
    hierarchy_nodes.reverse!
    resource_title = hierarchy_nodes.first || ""
  end

  # 3. Extract Resource Identifier
  if result.respond_to?(:resolved_resource) && result.resolved_resource.present?
    res = result.resolved_resource
    resource_id = res['identifier'] || [res['id_0'], res['id_1'], res['id_2'], res['id_3']].compact.join('-')
  elsif result.respond_to?(:identifier) && result.identifier.present?
    resource_id = result.identifier
  else
    # Extract ID fallback? Not sure if this will work...
    resource_id = result.json.dig('resource', 'ref')&.split('/')&.last || "N/A"
  end

  # Full hierarchy breadcrumb string (e.g. "Collection Name > Series I > Subseries A") No URIs, just the titles.
  full_hierarchy_path = hierarchy_nodes.join(" > ")

  has_online_content = result.json['representative_file_version'].present? || (dig.present? && dig.any? { |d| d['out'].present? })
  
  base_url = AppConfig[:public_proxy_url].to_s.chomp('/')
  full_url = "#{base_url}#{result.uri}"

  # Construct final payload string
  res_label = resource_id.present? && resource_id != "N/A" ? "#{resource_title} (#{resource_id})" : resource_title
  
  payload_raw = "Resource ID: #{resource_id} | Resource: #{res_label.presence || 'N/A'} | Hierarchy: #{full_hierarchy_path.presence || 'Root'} | Item: #{record_title} | Ref ID: #{item_ref_id} | Container: #{container_info.presence || 'Digital/No Physical Container'} | URL: #{full_url}"

  encoded_payload = ERB::Util.url_encode(payload_raw)
  request_form_url = "#{t('gwu_custom.materials_request_url')}?details_string=#{encoded_payload}"
%>

<%# 2. HTML CONTENT %>
<% gwu_body = capture do %>
  <div class="access-options-container">
    <div class="access-options-inner">
      
      <%# Status Alert Area %>
      <div class="alert access-alert <%= has_online_content ? 'alert-info' : 'access-alert-warning' %>">
        <% if has_online_content %> 
          <%= t('gwu_custom.status.online') %>
        <% elsif dig.present? %> 
          <strong><%= t('gwu_custom.status.restricted') %></strong>
        <% else %> 
          <strong><%= t('gwu_custom.status.default') %></strong>
        <% end %>
      </div>

      <%# Start of the Row for Columns %>
      <div class="row">
        
        <%# Column 1: Request Box %>
        <div class="col-md-4">
          <h3 class="access-title"><%= t('gwu_custom.facilitate_label') %></h3>
          
          <%# Target Badge Card (Adapts to Physical vs Digital) %>
          <div class="access-paging-card <%= has_physical_container ? 'card-physical' : 'card-digital' %>">
            <div class="paging-card-header">
              <%= has_physical_container ? t('gwu_custom.target_header_physical') : t('gwu_custom.target_header_digital') %>
            </div>
            
            <div class="paging-card-target">
              <% if has_physical_container %>
                <%= container_info %>
              <% else %>
                <span class="digital-label"><%= t('gwu_custom.digital_only') %></span>
              <% end %>
            </div>

            <div class="paging-card-item">
              <strong><%= has_physical_container ? t('gwu_custom.includes_item_physical') : t('gwu_custom.includes_item_digital') %></strong><br>
              <span class="item-title-text"><%= record_title %></span>
            </div>
          </div>

          <%# Adaptive Reading Room Notice %>
          <p class="access-text-small access-notice">
            <%= (has_physical_container ? t('gwu_custom.notice_physical') : t('gwu_custom.notice_digital')).html_safe %>
          </p>

          <div class="access-well">
            <input type="text" id="visible-barcode-text" value="<%= payload_raw %>">
            
            <div id="request-payload" style="display:none;"><%= payload_raw %></div>

            <button type="button" id="copy-btn" class="btn btn-xs btn-default pull-right" title="Copy full details">
              Copy
            </button>
          </div>
          
          <div id="copy-success" style="display:none;">
            <%= t('gwu_custom.details_copied') %>
          </div>
          
          <a href="<%= request_form_url %>" target="_blank" class="btn btn-sm btn-primary access-btn-full access-btn-bold">
            <% if has_physical_container %>
              <%= t('gwu_custom.request_btn_container_text', type: con_type, indicator: con_indicator) %>
            <% else %>
              <%= t('gwu_custom.request_btn_text', repo: cfg[:name]) %>
            <% end %>
          </a>
        </div>

        <%# Column 2: Visit %>
        <div class="col-md-4 access-col-divider">
          <h3 class="access-title"><%= t('gwu_custom.visit_label') %></h3>
          <p class="access-text-small"><%= t('gwu_custom.visit_text_preview') %></p>
          <a href="<%= cfg[:visit_url] %>" target="_blank" class="btn btn-sm btn-default access-btn-left">
            <%= t('gwu_custom.visit_link_text') %>
          </a>
          <a href="<%= t('gwu_custom.copyright_url') %>" target="_blank" class="btn btn-sm btn-default access-btn-left">
            <%= t('gwu_custom.copyright_link_text') %>
          </a>
        </div>

        <%# Column 3: Consult %>
        <div class="col-md-4 access-col-divider">
          <h3 class="access-title"><%= t('gwu_custom.consult_title') %></h3>
          <p class="access-text-small"><%= t('gwu_custom.consult_text') %></p>
          <a href="<%= cfg[:contact_url] %>" class="btn btn-sm btn-default access-btn-left">
            <%= t('gwu_custom.message_btn_text') %>
          </a>
        </div>

      </div> <%# End Row %>
    </div> <%# End Inner %>
  </div> <%# End Container %>
<% end %>

<%= render partial: 'shared/accordion_panel', locals: { :p_title => t('gwu_custom.panel_title'), :p_id => 'access_options_list', :p_body => gwu_body } %>